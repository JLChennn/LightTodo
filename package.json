{
  "name": "lighttodo",
  "productName": "LightTodo",
  "version": "1.0.0",
  "description": "A quiet, local-first desktop todo list. 轻一点，做得到。",
  "author": "JLChennn",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "format": "prettier --write src electron tests *.json *.ts *.cjs .github/workflows/*.yml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "io.github.jlchennn.lighttodo",
    "productName": "LightTodo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "LightTodo-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "LightTodo"
    }
  }
}
